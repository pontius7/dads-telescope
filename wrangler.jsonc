{
  // Static-assets-only Worker: there is no server code, so no `main` entry.
  // Cloudflare serves everything in dist/ straight from its edge.
  //
  // The name matches the project already created in the dashboard, so this
  // updates it in place rather than creating a second one.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dads-telescope-vol",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",

    // The Workers-native SPA fallback. This is the correct mechanism here —
    // a `_redirects` file with `/* -> /index.html 200` is the Pages idiom and
    // Cloudflare REJECTS it on Workers, because this runtime already strips
    // `/index.html` to `/`, so the rule re-triggers itself forever
    // (error 100324, which broke the first deploy).
    "not_found_handling": "single-page-application"
  },

  // Serve on <name>.<subdomain>.workers.dev without needing a custom domain.
  "workers_dev": true,

  "observability": {
    "enabled": true
  }
}
